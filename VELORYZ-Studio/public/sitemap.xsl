<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:sm="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8" indent="yes"/>
<xsl:template match="/">

<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Website sitemap | VELORYZ Studio</title>
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
<style>
:root{--navy:#111c32;--blue:#4267e8;--cyan:#23bde6;--warm:#f8f9f7;--line:#e5eaf0;--copy:#667286}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--warm);color:var(--navy);font-family:Inter,Manrope,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.65}a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid var(--blue);outline-offset:3px}.mast{display:flex;align-items:center;justify-content:space-between;gap:20px;max-width:1430px;padding:28px 40px;margin:auto;border-bottom:1px solid var(--line)}.mast img{width:146px;height:auto}.mast nav{display:flex;flex-wrap:wrap;align-items:center;gap:22px}.mast nav a{font-size:13px;font-weight:700;color:#5e6a7b}.mast .start{border-radius:9px;background:var(--navy);color:#fff;padding:9px 15px}.hero{max-width:1430px;margin:0 auto;padding:85px 40px 67px;position:relative;overflow:hidden}.hero:before{content:"";width:460px;height:460px;position:absolute;top:-170px;right:-100px;pointer-events:none;background:radial-gradient(circle,#d6ebff,transparent 67%)}.eyebrow{font:700 11px/1.4 ui-monospace,Consolas,monospace;letter-spacing:.16em;color:var(--blue)}h1{font-size:clamp(44px,7vw,91px);line-height:1.04;letter-spacing:-.071em;margin:20px 0 20px;max-width:900px}h1 em{color:var(--blue);font-style:normal}.hero p{font-size:17px;color:var(--copy);max-width:660px}.facts{display:flex;gap:25px;flex-wrap:wrap;border-top:1px solid var(--line);margin-top:40px;padding-top:18px}.facts span{font-size:12px;font-weight:700;color:#7d8ca1}.facts strong{color:var(--navy);font-size:21px;margin-right:7px}.overview{max-width:1430px;margin:auto;padding:20px 40px 100px}.sectiontop{display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:25px}.sectiontop h2{margin:0;font-size:32px;letter-spacing:-.048em}.sectiontop p{max-width:380px;font-size:13px;color:#778596}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.item{min-width:0;display:flex;align-items:center;gap:14px;padding:18px 19px;border:1px solid var(--line);border-radius:12px;background:#fff;transition:transform .2s,border-color .2s,box-shadow .2s}.item:hover{transform:translateY(-2px);border-color:#a4bdf8;box-shadow:0 8px 25px #14265710}.bullet{width:34px;height:34px;flex:none;border-radius:10px;background:#edf4ff;color:var(--blue);display:grid;place-items:center;font-size:17px}.itemtext{flex:1;min-width:0}.itemtext strong{display:block;font-size:13px;line-height:1.4;font-weight:760;overflow-wrap:anywhere}.itemtext small{display:block;color:#8b99aa;font-size:11px;margin-top:5px;overflow-wrap:anywhere}.item .arrow{color:var(--blue);font-size:19px}footer{background:#eaf2ff;padding:30px 40px;text-align:center;font-size:12px;color:#5d718a}footer a{font-weight:700;color:#3155b7;margin:0 10px}@media(max-width:700px){.mast{padding:20px;display:block}.mast nav{margin-top:17px;gap:12px}.hero{padding:53px 20px 35px}.overview{padding:20px 20px 70px}.grid{grid-template-columns:1fr}.sectiontop{display:block}.facts{gap:12px}.item{padding:14px}.itemtext small{font-size:10px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.item{transition:none}.item:hover{transform:none}}
</style></head>
<body><header class="mast"><a href="/" aria-label="VELORYZ Studio home"><img src="/assets/brand/official/Main-Dark-Ink-Transparent.webp" alt="VELORYZ Studio"/></a><nav aria-label="Documentation navigation"><a href="/docs/">Docs</a><a href="/help/studio/">Help Centre</a><a href="/docs/studio/">Studio docs</a><a href="/sitemap/">Visual site map</a><a href="/contact/" class="start">Contact the Studio</a></nav></header>
<section class="hero"><span class="eyebrow">VELORYZ / WEBSITE INDEX</span><h1>A map of<br/><em>everything connected.</em></h1><p>This is the XML sitemap presented in a readable view. Search engines receive the original machine-readable XML, while visitors can open any public page directly.</p><div class="facts"><span><strong><xsl:value-of select="count(sm:urlset/sm:url)"/></strong> indexed locations</span><span>Automatically generated from the Studio route registry</span><span>Updated with published documentation</span></div></section>
<main class="overview"><div class="sectiontop"><div><span class="eyebrow">THE FULL REFERENCE</span><h2>Browse indexed pages.</h2></div><p>Prefer an interactive directory? <a href="/sitemap/" style="color:#4267e8;font-weight:700">Open the visual site map ↗</a></p></div><div class="grid">
<xsl:for-each select="sm:urlset/sm:url"><xsl:sort select="sm:loc"/>
<a class="item" href="{sm:loc}"><span class="bullet">↗</span><span class="itemtext"><strong><xsl:choose><xsl:when test="contains(sm:loc, '/help/studio/')">Help Centre</xsl:when><xsl:when test="contains(sm:loc, '/docs/studio/')">Studio documentation</xsl:when><xsl:when test="contains(sm:loc, '/docs/')">Documentation</xsl:when><xsl:otherwise>VELORYZ page</xsl:otherwise></xsl:choose></strong><small><xsl:value-of select="sm:loc"/></small></span><span class="arrow">↗</span></a>
</xsl:for-each>
</div></main><footer><span>© VELORYZ Studio · Machine-readable XML with a human-friendly presentation</span><a href="/docs/">All docs</a><a href="/sitemap/">Interactive site map</a><a href="/sitemap.xml">Raw XML</a></footer></body></html>
</xsl:template></xsl:stylesheet>